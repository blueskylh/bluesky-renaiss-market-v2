BACKEND_PORT=3001
SURF_API_KEY=
RENAISS_API_BASE_URL=https://api.renaiss.xyz
RENAISS_PAGE_SIZE=100
RENAISS_MAX_CARDS=5000
RENAISS_MIN_INTERVAL_MS=150
# Throttle for sync DB writes (Surf DB proxy is rate-limited)
DB_WRITE_INTERVAL_MS=200
RENAISSOS_API_BASE_URL=https://api.renaissos.com
RENAISSOS_SITE_BASE_URL=https://index.renaissos.com
# Optional: without keys the public Index API allows only ~10 requests/day.
RENAISSOS_API_KEY=
RENAISSOS_API_SECRET=
RENAISSOS_MIN_INTERVAL_MS=250
RENAISSOS_MAX_RETRIES=3
# Optional server-side token for manual POST /api/sync. Leave empty to disable it.
SYNC_ADMIN_TOKEN=
